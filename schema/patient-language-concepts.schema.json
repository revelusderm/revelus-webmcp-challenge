{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revelusdermatology.com/schemas/patient-language-concepts.schema.json",
  "title": "Revelus patient-language concept registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "sourceCorpusSha256", "concepts", "ambiguities"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0.0"},
    "locale": {"type": "string", "const": "en-US"},
    "sourceCorpusSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "concepts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/concept"}},
    "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "phraseList": {
      "type": "array",
      "items": {"type": "string", "minLength": 2, "maxLength": 100},
      "uniqueItems": true
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptId", "canonicalLabel", "kind", "recordId", "sourceUrl", "patientPhrases", "strongSignals", "weakSignals", "negativeSignals", "contrasts", "ambiguityFlags", "reviewStatus"],
      "properties": {
        "conceptId": {"$ref": "#/$defs/id"},
        "canonicalLabel": {"type": "string", "minLength": 2, "maxLength": 120},
        "kind": {"enum": ["condition", "cosmetic_service", "medical_service", "provider", "booking_scope"]},
        "recordId": {"type": ["string", "null"]},
        "sourceUrl": {"type": ["string", "null"], "pattern": "^https://revelusdermatology\\.com/"},
        "patientPhrases": {"$ref": "#/$defs/phraseList"},
        "commonMisspellings": {"$ref": "#/$defs/phraseList"},
        "strongSignals": {"$ref": "#/$defs/phraseList"},
        "weakSignals": {"$ref": "#/$defs/phraseList"},
        "negativeSignals": {"$ref": "#/$defs/phraseList"},
        "contrasts": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "ambiguityFlags": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "bookingRouteCandidate": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
        "bookingConfidence": {"enum": ["none", "candidate", "validated"]},
        "reviewStatus": {"enum": ["generated", "review_required", "reviewed"]},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambiguityId", "triggerPhrases", "candidateConceptIds", "clarificationQuestion", "options", "defaultAction", "bookingSuppressedUntilClarified"],
      "properties": {
        "ambiguityId": {"$ref": "#/$defs/id"},
        "triggerPhrases": {"$ref": "#/$defs/phraseList"},
        "candidateConceptIds": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "clarificationQuestion": {"type": "string", "minLength": 5, "maxLength": 240},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "conceptId"],
            "properties": {
              "label": {"type": "string", "minLength": 2},
              "conceptId": {"$ref": "#/$defs/id"}
            }
          }
        },
        "defaultAction": {"const": "clarify"},
        "bookingSuppressedUntilClarified": {"type": "boolean", "const": true},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
